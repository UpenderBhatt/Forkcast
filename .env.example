# Copy this file to .env and fill in the two Supabase values (SETUP.md, step 5).
# Supabase > Project Settings > API (or "Connect" at the top of the dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Optional, once the web version is online (SETUP.md, step 8). Used in share links.
EXPO_PUBLIC_SHARE_URL=
